# 复制为 .env 并按环境修改；.env 不入库。

# PostgreSQL
POSTGRES_USER=yiren
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yiren_jianghu
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# API
API_PORT=4000

# 仅本地自测可取消注释；生产环境必须保持关闭。
# ALLOW_ANY_INVITE=1

# 数据库连接（供 API / Worker / 迁移脚本使用）
DATABASE_URL=postgres://yiren:change-me@localhost:5432/yiren_jianghu
