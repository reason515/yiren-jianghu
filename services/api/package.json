{
  "name": "@yjh/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@yjh/content": "workspace:*",
    "@yjh/game-core": "workspace:*",
    "@yjh/shared": "workspace:*",
    "fastify": "^5.11.2"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@yjh/worker": "workspace:*",
    "node-pg-migrate": "^7.6.0",
    "pg": "^8.13.0",
    "redis": "^6.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:docs": "vitest run src/protocol.contract.test.ts",
    "test:e2e": "vitest run -c ../../vitest.e2e.config.ts",
    "migrate:up": "node --env-file-if-exists=../../.env node_modules/node-pg-migrate/bin/node-pg-migrate up -m ./migrations",
    "migrate:down": "node --env-file-if-exists=../../.env node_modules/node-pg-migrate/bin/node-pg-migrate down -m ./migrations -c 1",
    "migrate:create": "node --env-file-if-exists=../../.env node_modules/node-pg-migrate/bin/node-pg-migrate create -m ./migrations",
    "seed": "node ./scripts/seed.mjs"
  }
}
